{
  "manifest_version": 3,
  "name": "Recipe Manager Connect",
  "version": "2.0.0",
  "description": "Links Albert Heijn and places orders to Jumbo for Recipe Manager.",
  "background": { "service_worker": "background.js" },
  "permissions": ["webRequest", "storage", "webNavigation", "scripting"],
  "host_permissions": ["*://*.ah.nl/*", "*://*.jumbo.com/*", "http://localhost:3000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["*://*.ah.nl/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.ah.nl/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["app-relay.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Recipe Manager Connect" }
}
