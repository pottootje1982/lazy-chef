# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://recipe:recipe@localhost:5432/recipes?schema=public"

# Auth.js — generate a secret with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Google Cloud Translation API key (enable "Cloud Translation API", billing on).
# Used to translate ingredients EN->NL for the Dutch grocer (Picnic).
GOOGLE_TRANSLATE_API_KEY="your-google-translate-api-key"

# 32-byte base64 key encrypting each user's Picnic auth key at rest.
# Generate with: openssl rand -base64 32
PICNIC_ENC_KEY="replace-me"

# Google Cloud Vision API key (enable "Cloud Vision API", billing on).
# OCR for the "Scan a photo" recipe importer. May reuse the Translate key's
# project if Vision is enabled on it.
GOOGLE_VISION_API_KEY="your-google-vision-api-key"

# Google Cloud Storage for cropped recipe photos from the scan importer.
# Bucket must allow public reads (uniform bucket-level access + allUsers
# Storage Object Viewer).
GCS_BUCKET="your-bucket-name"
# Base64-encoded service-account JSON with Storage Object Admin on the bucket.
# Generate with: base64 -i service-account.json | tr -d '\n'
GCS_SA_KEY="base64-encoded-service-account-json"
