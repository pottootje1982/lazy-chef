// Prisma schema — Postgres. Run `npm run db:push` to sync.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js (NextAuth) models ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  picnicAuthKey String? // AES-GCM encrypted Picnic auth key; null if not linked
  picnicPendingKey String? // AES-GCM encrypted interim auth key during 2FA login; null otherwise
  accounts      Account[]
  sessions      Session[]
  recipes       Recipe[]
  mappings      ProductMapping[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Application models ----
model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  imageUrl     String?
  sourceUrl    String?
  servings     String?
  prepTime     String?
  cookTime     String?
  ingredients  String[]
  instructions String[]
  tags         String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Maps a (normalized) ingredient to a chosen Picnic product, per user.
// Reusable: keyed by ingredientKey so the link applies across all recipes.
model ProductMapping {
  id            String   @id @default(cuid())
  userId        String
  ingredientKey String // normalized english ingredient, e.g. "cherry tomatoes"
  rawIngredient String // original ingredient line, for reference
  translated    String // dutch search term used
  picnicId      String // Picnic selling unit id, e.g. "s1001524"
  productName   String
  imageId       String?
  priceCents    Int?
  unitQuantity  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientKey])
  @@index([userId])
}

// Shared translation cache (not user-specific) to avoid repeat API calls.
model Translation {
  source String @id // normalized english
  target String // dutch
}
