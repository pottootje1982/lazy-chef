// Prisma schema — Postgres. Run `npm run db:push` to sync.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js (NextAuth) models ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  isGuest       Boolean  @default(false) // read-only demo account
  picnicAuthKey String? // AES-GCM encrypted Picnic auth key; null if not linked
  picnicPendingKey String? // AES-GCM encrypted interim auth key during 2FA login; null otherwise
  paprikaEmail    String? // Paprika sync account email
  paprikaPassword String? // AES-GCM encrypted Paprika password (Basic-auth per call)
  // Pantry staple keywords: linked ingredients whose normalized key contains one
  // of these are unticked by default when ordering. Seeded with sensible defaults.
  pantryKeywords String[] @default(["oil", "garlic", "salt", "sugar", "flour", "butter", "vinegar", "honey", "stock", "broth", "bouillon", "oregano", "thyme", "rosemary", "cumin", "paprika", "cinnamon", "nutmeg", "basil", "parsley", "coriander", "soy", "baking", "yeast", "water", "mustard"])
  // Normalized ingredient keys the user has hidden from the linking page (junk lines).
  ignoredIngredients String[] @default([])
  accounts      Account[]
  sessions      Session[]
  recipes       Recipe[]
  mappings      ProductMapping[]
  orders        Order[]
  groceryLists  GroceryList[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Application models ----
model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  imageUrl     String?
  sourceUrl    String?
  servings     String?
  prepTime     String?
  cookTime     String?
  ingredients  String[]
  instructions String[]
  tags         String[]
  categories   String[] @default([]) // derived: vegetarian, vegan, fish, meat, dessert
  paprikaUid   String? // source Paprika recipe uid (for dedup on re-sync)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paprikaUid])
  @@index([userId])
}

// Maps a (normalized) ingredient to a chosen Picnic product, per user.
// Reusable: keyed by ingredientKey so the link applies across all recipes.
model ProductMapping {
  id            String   @id @default(cuid())
  userId        String
  ingredientKey String // normalized english ingredient, e.g. "cherry tomatoes"
  rawIngredient String // original ingredient line, for reference
  translated    String // dutch search term used
  picnicId      String // Picnic selling unit id, e.g. "s1001524"
  productName   String
  imageId       String?
  priceCents    Int?
  unitQuantity  String?
  isStaple      Boolean? // pantry override: null = follow keywords, true/false = force
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientKey])
  @@index([userId])
}

// Shared translation cache (not user-specific) to avoid repeat API calls.
model Translation {
  source String @id // normalized english
  target String // dutch
}

enum OrderStatus {
  DRAFT // the current selection, autosaved
  PLACED // sent to the Picnic cart; shows under "previous orders"
}

// An order groups selected recipes + chosen products. One DRAFT per user holds
// the current selection; placing it (Add to Picnic cart) flips it to PLACED.
model Order {
  id                 String      @id @default(cuid())
  userId             String
  status             OrderStatus @default(DRAFT)
  recipeIds          String[] // selected recipes
  recipeTitles       String[] // snapshot of titles for display
  listIds            String[] // selected grocery lists
  listTitles         String[] // snapshot of list names for display
  selectedProductIds String[] // currently-ticked Picnic product ids
  selectedQuantities Json? // per-product quantity overrides { picnicId: qty }
  placedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[] // product snapshot, populated when placed

  @@index([userId, status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  picnicId     String
  productName  String
  imageId      String?
  priceCents   Int?
  unitQuantity String?
  quantity     Int     @default(1)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// A named, reusable list of Picnic products ("weekly recurring groceries").
// Orderable like a recipe; never shown in the recipe grid.
model GroceryList {
  id        String        @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     GroceryItem[]

  @@index([userId])
}

model GroceryItem {
  id           String  @id @default(cuid())
  listId       String
  picnicId     String
  productName  String
  imageId      String?
  priceCents   Int?
  unitQuantity String?
  quantity     Int     @default(1)

  list GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, picnicId])
  @@index([listId])
}
