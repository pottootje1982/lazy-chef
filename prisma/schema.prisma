// Prisma schema — Postgres. Schema changes: `npm run migrate -- --name <desc>`
// (creates a versioned migration). `prisma migrate dev` needs a scratch shadow
// DB — set to a separate Neon branch via SHADOW_DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---- Auth.js (NextAuth) models ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  isGuest       Boolean  @default(false) // read-only demo account
  picnicAuthKey String? // AES-GCM encrypted Picnic auth key; null if not linked
  picnicPendingKey String? // AES-GCM encrypted interim auth key during 2FA login; null otherwise
  grocer        String   @default("picnic") // active grocer for search/order: "picnic" | "ah"
  ahAuthKey     String? // AES-GCM encrypted Albert Heijn refresh token; null if not linked
  paprikaEmail    String? // Paprika sync account email
  paprikaPassword String? // AES-GCM encrypted Paprika password (Basic-auth per call)
  // Pantry staple keywords: linked ingredients whose normalized key contains one
  // of these are unticked by default when ordering. Seeded with sensible defaults.
  pantryKeywords String[] @default(["oil", "garlic", "salt", "sugar", "flour", "butter", "vinegar", "honey", "stock", "broth", "bouillon", "oregano", "thyme", "rosemary", "cumin", "paprika", "cinnamon", "nutmeg", "basil", "parsley", "coriander", "soy", "baking", "yeast", "water", "mustard"])
  // Normalized ingredient keys the user has hidden from the linking page (junk lines).
  ignoredIngredients String[] @default([])
  // Normalized ingredient keys that can't be bought at the grocer (buy elsewhere).
  unavailableIngredients String[] @default([])
  // Auto-save an ordered ad-hoc recipe selection as a week plan, when it has at
  // least `autoWeekPlanMinRecipes` recipes.
  autoWeekPlanEnabled    Boolean @default(true)
  autoWeekPlanMinRecipes Int     @default(3)
  // Preferred UI language ("nl" | "en"). Dutch is the default for everyone.
  language      String   @default("nl")
  accounts      Account[]
  sessions      Session[]
  recipes       Recipe[]
  mappings      ProductMapping[]
  orders        Order[]
  groceryLists  GroceryList[]
  weekPlans     WeekPlan[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Application models ----
model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  imageUrl     String?
  sourceImageUrl String? // full original photo from the OCR scan importer (GCS)
  sourceUrl    String?
  origin       String? // how the recipe was created: manual | url | scan | paprika
  quantityOverrides Json? // per-ingredient order qty overrides: { [ingredientKey]: number }
  servings     String?
  prepTime     String?
  cookTime     String?
  ingredients  String[]
  instructions String[]
  tags         String[]
  categories   String[] @default([]) // derived: vegetarian, vegan, fish, meat, dessert
  paprikaUid   String? // source Paprika recipe uid (for dedup on re-sync)
  lastOrderedAt DateTime? // last time this recipe was ordered (added to Picnic cart)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paprikaUid])
  @@index([userId])
}

// Maps a (normalized) ingredient to a chosen Picnic product, per user.
// Reusable: keyed by ingredientKey so the link applies across all recipes.
model ProductMapping {
  id            String   @id @default(cuid())
  userId        String
  ingredientKey String // normalized english ingredient, e.g. "cherry tomatoes"
  rawIngredient String // original ingredient line, for reference
  translated    String // dutch search term used
  grocer        String   @default("picnic") // "picnic" | "ah"
  picnicId      String // grocer product id (Picnic selling unit id, or AH webshopId)
  productName   String
  imageId       String? // Picnic image id, or an AH image URL
  priceCents    Int?
  unitQuantity  String?
  isStaple      Boolean? // pantry override: null = follow keywords, true/false = force
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientKey, grocer])
  @@index([userId])
}

// Shared translation cache (not user-specific) to avoid repeat API calls.
model Translation {
  source String @id // normalized english
  target String // dutch
}

enum OrderStatus {
  DRAFT // the current selection, autosaved
  PLACED // sent to the Picnic cart; shows under "previous orders"
}

// A reusable, named batch of recipes. Ordered least-recently-used first so the
// planning used longest ago (or never) surfaces on top.
model WeekPlan {
  id            String    @id @default(cuid())
  userId        String
  name          String
  recipeIds     String[]
  lastOrderedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// An order groups selected recipes + chosen products. One DRAFT per user holds
// the current selection; placing it (Add to Picnic cart) flips it to PLACED.
model Order {
  id                 String      @id @default(cuid())
  userId             String
  status             OrderStatus @default(DRAFT)
  recipeIds          String[] // selected recipes
  recipeTitles       String[] // snapshot of titles for display
  listIds            String[] // selected grocery lists
  listTitles         String[] // snapshot of list names for display
  selectedProductIds String[] // currently-ticked Picnic product ids
  selectedQuantities Json? // per-product quantity overrides { picnicId: qty }
  // Ad-hoc products added to the draft via "basket" buttons (grocery items,
  // recipe ingredients): [{ picnicId, name, imageId, priceCents, unitQuantity, quantity }]
  cartItems          Json?
  weekPlanId         String? // set when ordering from a week planning; stamps it on placement
  unavailableItems   String[] // snapshot of not-available ingredient lines (buy elsewhere)
  placedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[] // product snapshot, populated when placed

  @@index([userId, status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  grocer       String  @default("picnic") // "picnic" | "ah"
  picnicId     String
  productName  String
  imageId      String?
  priceCents   Int?
  unitQuantity String?
  quantity     Int     @default(1)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// A named, reusable list of Picnic products ("weekly recurring groceries").
// Orderable like a recipe; never shown in the recipe grid.
model GroceryList {
  id        String        @id @default(cuid())
  userId    String
  name      String
  grocer    String        @default("picnic") // "picnic" | "ah"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     GroceryItem[]

  @@index([userId])
}

model GroceryItem {
  id           String  @id @default(cuid())
  listId       String
  picnicId     String
  productName  String
  imageId      String?
  priceCents   Int?
  unitQuantity String?
  quantity     Int     @default(1)

  list GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, picnicId])
  @@index([listId])
}
